# The Docker image downloads the prebuilt release binary, so the build
# context only needs the Dockerfile. Exclude everything heavy/irrelevant to
# keep the context small and builds fast.
target/
# Exception: the local-build Dockerfile (Dockerfile.local, used by
# `task docker:build`) copies a locally-compiled musl binary from target/.
!target/*-unknown-linux-musl/release/datapress
data/
docs/site/
docs/docs/site/
.git/
.github/
**/*.parquet
**/*.csv
wheels/
dist/
.venv/
**/__pycache__/
